<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Parallel tests block pool threads while they wait, and FIO's workers run on the pool: with the default
             minimum (one thread per core) the runtimes under test stalled for seconds and missed timing budgets. -->
        <ThreadPoolMinThreads>64</ThreadPoolMinThreads>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/Utilities.fs" Link="Utils/SharedUtilities.fs" />
        <Compile Include="Utils/Utilities.fs" />
        <Compile Include="TypesTests.fs" />
        <Compile Include="CodecTests.fs" />
        <Compile Include="WebSocketTests.fs" />
        <Compile Include="WebSocketClientTests.fs" />
        <Compile Include="WebSocketServerTests.fs" />
        <Compile Include="ExtensionsTests.fs" />
        <Compile Include="CancellationTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\FIO.WebSockets\FIO.WebSockets.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
    </ItemGroup>

</Project>
