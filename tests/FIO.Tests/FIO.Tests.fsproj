<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Utils -->
        <Compile Include="Utils/Utilities.fs" />
        <Compile Include="Utils/ChildProcess.fs" />

        <!-- DSL -->
        <Compile Include="DSL/CETests.fs" />
        <Compile Include="DSL/ChannelTests.fs" />
        <Compile Include="DSL/RefTests.fs" />
        <Compile Include="DSL/Extensions/MappingTests.fs" />
        <Compile Include="DSL/Extensions/PredicateTests.fs" />
        <Compile Include="DSL/Extensions/ObservationTests.fs" />
        <Compile Include="DSL/Extensions/RecoveryTests.fs" />
        <Compile Include="DSL/Extensions/ZipTests.fs" />
        <Compile Include="DSL/Extensions/RetryTests.fs" />
        <Compile Include="DSL/Extensions/TimingTests.fs" />
        <Compile Include="DSL/Extensions/RacingTests.fs" />
        <Compile Include="DSL/Factories/ConstructorTests.fs" />
        <Compile Include="DSL/Factories/SuspensionTests.fs" />
        <Compile Include="DSL/Factories/TaskInteropTests.fs" />
        <Compile Include="DSL/Factories/TimeTests.fs" />
        <Compile Include="DSL/Factories/ResourceTests.fs" />
        <Compile Include="DSL/Factories/InterruptibilityTests.fs" />
        <Compile Include="DSL/Factories/TraversalTests.fs" />
        <Compile Include="DSL/Factories/LoopTests.fs" />
        <Compile Include="DSL/Factories/AggregationTests.fs" />
        <Compile Include="DSL/Factories/BranchingTests.fs" />
        <Compile Include="DSL/JoinFirstTests.fs" />
        <Compile Include="DSL/JoinAllFailFastTests.fs" />
        <Compile Include="DSL/FiberTests.fs" />
        <Compile Include="DSL/FIOTests.fs" />
        <Compile Include="DSL/OperatorTests.fs" />

        <!-- Lib -->
        <Compile Include="Lib/ConsoleTests.fs" />

        <!-- Framework -->
        <Compile Include="Runtime/WorkerInfrastructureTests.fs" />
        <Compile Include="Runtime/ConformanceTests.fs" />
        <Compile Include="Runtime/InterpreterSizeTests.fs" />
        <Compile Include="Framework/AppTests.fs" />

        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\FIO\FIO.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="Expecto.FsCheck" />
        <PackageReference Include="FsCheck" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
    </ItemGroup>

</Project>
