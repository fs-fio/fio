<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Utils/Utilities.fs" />
        <Compile Include="../Shared/ChildProcessRunner.fs" Link="Utils/ChildProcessRunner.fs" />
        <Compile Include="Utils/ChildProcess.fs" />
        <Compile Include="TypesTests.fs" />
        <Compile Include="ResponseTests.fs" />
        <Compile Include="HandlerTests.fs" />
        <Compile Include="RoutePatternTests.fs" />
        <Compile Include="RoutesTests.fs" />
        <Compile Include="MiddlewareTests.fs" />
        <Compile Include="KestrelBridgeTests.fs" />
        <Compile Include="ServerTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\FIO.Http\FIO.Http.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
    </ItemGroup>

</Project>
